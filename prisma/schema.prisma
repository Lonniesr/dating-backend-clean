generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  theme              String?        @default("light")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  inviteCode         String?
  username           String?
  birthdate          DateTime?
  gender             String?
  name               String?
  onboardingComplete Boolean        @default(false)

  photos             String[]       @default([])
  preferences        Json?
  prompts            Json?

  role               String         @default("user")

  age                Int?
  bio                String?
  birthplace         String?
  location           String?

  race               String?

  verified           Boolean        @default(false)

  // ⭐ ADD THESE
  verification_status String?       @default("unverified")
  verification_selfie String?

  banned             Boolean        @default(false)
  lastActiveAt       DateTime?

  adminFlags         Json?
  adminNotes         String?

  // ⭐ Super Likes
  superLikesRemaining Int            @default(3)
  superLikesResetAt   DateTime?

  Admin              Admin?
  conversationsA     Conversation[] @relation("UserAConversations")
  conversationsB     Conversation[] @relation("UserBConversations")
  invitesSent        Invite[]       @relation("Invite_invitedByIdToUser")
  invitesUsed        Invite[]       @relation("Invite_usedByIdToUser")
  matchesAsUserA     Match[]        @relation("Match_userA")
  matchesAsUserB     Match[]        @relation("Match_userB")
  receivedMessages   Message[]      @relation("ReceivedMessages")
  sentMessages       Message[]      @relation("SentMessages")
  swipesGiven        Swipe[]        @relation("Swipe_swiperIdToUser")
  swipesReceived     Swipe[]        @relation("Swipe_targetIdToUser")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  userId    String?  @unique
  User      User?    @relation(fields: [userId], references: [id])
}

model AdminSettings {
  id              String   @id @default("admin-settings")
  maintenanceMode Boolean  @default(false)
  siteName        String   @default("Lynq Admin")
  supportEmail    String   @default("support@example.com")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageId String?
  lastMessage   Message?  @relation("LastMessage", fields: [lastMessageId], references: [id])
  userA         User      @relation("UserAConversations", fields: [userAId], references: [id])
  userB         User      @relation("UserBConversations", fields: [userBId], references: [id])
  messages      Message[]
}

model Invite {
  id                            Int       @id @default(autoincrement())
  code                          String    @unique
  createdAt                     DateTime  @default(now())
  used                          Boolean   @default(false)
  usedAt                        DateTime?
  email                         String?
  usedById                      String?
  expiresAt                     DateTime?
  invitedById                   String?
  premium                       Boolean   @default(false)

  // 🔥 Growth Analytics
  scanCount                     Int       @default(0)
  signupCount                   Int       @default(0)

  User_Invite_invitedByIdToUser User?     @relation("Invite_invitedByIdToUser", fields: [invitedById], references: [id])
  User_Invite_usedByIdToUser    User?     @relation("Invite_usedByIdToUser", fields: [usedById], references: [id])

  scans                         InviteScan[]
}

model InviteScan {
  id        Int      @id @default(autoincrement())
  inviteId  Int
  createdAt DateTime @default(now())

  // 🔥 Device Analytics
  device    String?
  browser   String?
  os        String?
  ip        String?

  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
}

model Match {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userAId   String
  userBId   String
  userA     User     @relation("Match_userA", fields: [userAId], references: [id])
  userB     User     @relation("Match_userB", fields: [userBId], references: [id])
}

model Message {
  id                 String         @id @default(uuid())

  senderId           String
  receiverId         String

  createdAt          DateTime       @default(now())

  text               String?
  audioUrl           String?
  imageUrl           String?
  reaction           String?

  read               Boolean        @default(false)
  delivered          Boolean        @default(false)

  conversationId     String?

  // reply system
  replyToId          String?
  replyTo            Message?       @relation("MessageReply", fields: [replyToId], references: [id])
  replies            Message[]      @relation("MessageReply")

  // conversation relations
  lastInConversation Conversation[] @relation("LastMessage")
  conversation       Conversation?  @relation(fields: [conversationId], references: [id])

  // user relations
  receiver           User           @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender             User           @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model Swipe {
  id                        String   @id @default(uuid())
  swiperId                  String
  targetId                  String
  direction                 String
  createdAt                 DateTime @default(now())

  User_Swipe_swiperIdToUser User     @relation("Swipe_swiperIdToUser", fields: [swiperId], references: [id])
  User_Swipe_targetIdToUser User     @relation("Swipe_targetIdToUser", fields: [targetId], references: [id])

  @@unique([swiperId, targetId])
}